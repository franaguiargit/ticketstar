# Copiar este archivo como .env si hace falta cambiar algo.
# Si el puerto 80 ya está ocupado en tu máquina, usá otro (por ejemplo 8080)
# y agregalo a las URLs: http://teatro-avenida.ticketstar.localhost:8080/v1/eventos
PUERTO_GATEWAY=80

# Solo para la demo de concurrencia: con 1 la reserva de butacas queda SIN el
# control y se puede ver el problema (ver pruebas/README.md). Dejarlo en 0.
RESERVA_SIN_CONTROL=0
